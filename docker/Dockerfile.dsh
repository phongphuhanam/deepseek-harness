# Docker deployment of DeepSeek Harness (dsh), built FROM SOURCE on the
# feature/web-base-path branch: the --base-path subfolder-proxy support
# isn't in the published @deepseek-ai/dsh npm package yet. Pointed at a
# remote Ollama instance instead of a hosted provider.
FROM node:24-bookworm-slim

# Optional apt-get cache (e.g. apt-cacher-ng running on the Docker host at
# port 3142). Pass --build-arg APT_PROXY=http://host.docker.internal:3142
# to use it; omit to fetch packages directly.
ARG APT_PROXY
RUN if [ -n "$APT_PROXY" ]; then \
      printf 'Acquire::http::Proxy "%s";\n' "$APT_PROXY" > /etc/apt/apt.conf.d/01proxy; \
    fi

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       bash ca-certificates git ripgrep curl \
       openssh-client rsync rclone \
  && rm -rf /var/lib/apt/lists/* \
  && rm -f /etc/apt/apt.conf.d/01proxy

RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

# Build the monorepo in /repo (root's own checkout, not the mounted
# /workspace below -- that stays free for whatever project you point the
# agent at, same as the pi-mono sandbox).
WORKDIR /repo
COPY . .
RUN git config --global --add safe.directory /repo \
  && pnpm install --frozen-lockfile \
  && pnpm run build

# Run as the non-root "node" user baked into this image (uid/gid 1000),
# matching a typical host user so bind-mounted files don't need chowning.
# /repo is read-only at runtime (dsh writes to $DSH_HOME, not here), so it
# stays root-owned -- apt/npm-installed files are world-readable by default,
# and a recursive chown over the whole node_modules tree is the slowest
# single step of this build on modest hardware.
RUN mkdir -p /workspace && chown node:node /workspace
USER node

WORKDIR /workspace
ENTRYPOINT ["node", "/repo/apps/cli/lib/bin.js"]
CMD ["web", "--no-open"]
